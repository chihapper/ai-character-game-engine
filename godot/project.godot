; Godot 4.x project — the Phase B native client. A THIN renderer over the Python game-core
; (game/rpg/server.py). All game logic + the engine stay in Python; this project only draws
; snapshots and sends input over a local WebSocket.

config_version=5

[application]

config/name="Sunken Vault — Godot client"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Net="*res://net.gd"

[display]

window/size/viewport_width=1152
window/size/viewport_height=720
