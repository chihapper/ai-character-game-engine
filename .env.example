# Copy this file to `.env` and fill in your keys. NEVER commit `.env`.

# --- Anthropic (LLM) ---
# Get a key at https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=

# --- Inworld (default TTS + voice cloning) ---
# Portal: https://platform.inworld.ai/ -> API Keys -> copy the "Basic (Base64)" signature.
# Paste it verbatim (it is already base64-encoded key:secret). Do NOT re-encode it.
INWORLD_API_KEY=

# --- Cartesia (alternative TTS + voice cloning, for A/B) ---
# Get a key at https://play.cartesia.ai/keys  (format: sk_car_...)
CARTESIA_API_KEY=

# --- AssemblyAI (cloud speech-to-text; no local Whisper/CUDA needed) ---
# Get a key at https://www.assemblyai.com/ (Dashboard -> API Keys)
ASSEMBLYAI_API_KEY=

# --- Optional overrides (sensible defaults live in config.py) ---
# STT_PROVIDER=assemblyai      # "assemblyai" (cloud) or "whisper" (local). Default: whisper
# WHISPER_DEVICE=cuda          # "cpu" or "cuda" (only when STT_PROVIDER=whisper)
# WHISPER_COMPUTE_TYPE=int8
# LLM_MODEL=claude-sonnet-4-6
# DEFAULT_TTS_PROVIDER=inworld
# HOST=127.0.0.1
# PORT=8000
