# Copy this file to `.env` and fill in your keys. NEVER commit `.env`.
# Anthropic is required for everything. The port 8000 app also needs the TTS key of the character
# you connect to (most shipped characters use Inworld), because it has no text-only mode. The
# Director's Sandbox and the Ferry text game need no TTS key.

# --- Anthropic (LLM: the actor and judge seats) ---
# Get a key at https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=

# --- Hume Octave (the chosen TTS, but NOT selected by any default) ---
# Get a key at https://platform.hume.ai/
# To use Hume on the game server, also set GAME_TTS=hume below.
# On the port 8000 app, set `tts_provider: hume` in the character YAML.
HUME_API_KEY=

# --- Inworld (TTS + voice cloning; most shipped characters use it on port 8000) ---
# Portal: https://platform.inworld.ai/ -> API Keys -> copy the "Basic (Base64)" signature.
# Paste it verbatim (it is already base64-encoded key:secret). Do NOT re-encode it.
INWORLD_API_KEY=

# --- ElevenLabs (TTS + voice cloning; DEFAULT_TTS_PROVIDER falls back to it) ---
# Get a key at https://elevenlabs.io/ (Profile -> API Keys)
ELEVENLABS_API_KEY=

# --- Cartesia (TTS + voice cloning, for A/B; also the /ws outage fallback when set) ---
# Get a key at https://play.cartesia.ai/keys  (format: sk_car_...)
CARTESIA_API_KEY=

# --- Fish Audio (TTS, kept from the bake-off) ---
FISH_API_KEY=

# --- AssemblyAI (cloud speech-to-text; no local Whisper/CUDA needed) ---
# Get a key at https://www.assemblyai.com/ (Dashboard -> API Keys)
ASSEMBLYAI_API_KEY=

# --- Optional overrides (sensible defaults live in config.py) ---

# Port 8000 app
# LLM_MODEL=claude-sonnet-4-6
# DEFAULT_TTS_PROVIDER=elevenlabs   # or hume / inworld / cartesia / fish / chatterbox
# STT_PROVIDER=assemblyai      # "assemblyai" (cloud) or "whisper" (local). Default: whisper
# WHISPER_DEVICE=cuda          # "cpu" or "cuda" (only when STT_PROVIDER=whisper)
# WHISPER_COMPUTE_TYPE=int8
# HOST=127.0.0.1
# PORT=8000

# Game server (python -m game.server)
# GAME_TTS=hume                # hume / inworld / elevenlabs / fish / chatterbox. Default: inworld
#                              # The Ferry /play voice only works with GAME_TTS=hume.
# GAME_HOST=127.0.0.1
# GAME_PORT=8001

# Judge seat. All three default to claude-sonnet-4-6, the only model to pass the full-life battery.
# See docs/judge-seat-requirements.md before changing these.
# SALIENCE_MODEL=claude-sonnet-4-6
# REFLECTION_MODEL=claude-sonnet-4-6
# DELIBERATION_MODEL=claude-sonnet-4-6

# Local models: name a judge seat `local/<model>` to route it to an OpenAI-compatible server.
# LLM_MODEL does not route this way.
# These are read from the process environment, and orchestrator.main doesn't load .env into it,
# so for port 8000 set them in your shell. The game server and tools do load them from here.
# LOCAL_JUDGE_BASE_URL=http://127.0.0.1:11434/v1   # Ollama. The code default is :8080 (llama-server)
# LOCAL_JUDGE_API_KEY=
