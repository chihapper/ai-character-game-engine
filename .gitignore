# Secrets
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Local model / data caches
.chroma/
chroma_db/
.memory/
*.wav
# ...except the game's own generated SFX/ambience set (small, original, regenerable via
# tools/gen_rpg_sfx.py) — their .import descriptors are tracked, so the wavs must be too.
!godot/assets/sfx/*.wav
*.webm

# Per-speaker voice/cadence profiles (local user data)
orchestrator/profiles/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Realtime API feasibility spikes (throwaway)
spike_out/
realtime_*.py

# A/B protocol outputs (transcripts + audio)
ab_out/

# runtime server log
server.log

# game runtime transcripts (per-playthrough, generated)
.game_runs/
game_server.err
game_server.out

# stress-test transcripts + run logs (tools/stress_*.py) — generated, not source
stress_*.md
stress_*.log
stress_grounding*.md
*_run.log
grounding_judge.log

# director sandbox runtime (dev tool)
.sandbox_scenarios/
sandbox_server.log
.sandbox_saves/
sandbox_server.err
sandbox_server.out
bri_romance_transcript.md
unity/ProAssets/packs/*.zip

tts_bakeoff_out/

# Runtime dev logs (server/client/spike stdout+stderr) — never commit
*.log
*.out.log
*.err.log
spikes/evi_clm_requests.jsonl
.saves/

# Dialogue-card portraits: royalty-free-but-NO-redistribution packs (two-tier asset policy —
# CC0 gets committed; these stay local; see godot/assets/portraits/README.md for re-fetch)
godot/assets/portraits/*
!godot/assets/portraits/README.md
